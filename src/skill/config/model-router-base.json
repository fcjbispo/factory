{
  "$schema": "./model-router-schema.json",
  "version": "2.0.0",
  "description": "Model Router for Factory — LLM model allocation by role using capabilities and dynamic discovery",
  "constraint": {
    "max_concurrent_models": 3,
    "description": "Maximum of 3 concurrent LLM models per Ollama account"
  },
  "allocation_strategy": "capability-based-matching",

  "discovery": {
    "method": "query_available_models",
    "description": "Discover available models at installation time",
    "sources": [
      "~/.openclaw/openclaw.json (agents.defaults.models)",
      "Provider API (Ollama)",
      "Environment variable: FACTORY_AVAILABLE_MODELS"
    ],
    "refresh_interval": "at every project initialization"
  },

  "capability_definitions": {
    "description": "Capabilities a model can have. The agent maps available models to these capabilities.",
    
    "deep_reasoning": {
      "description": "Complex reasoning, architecture, structural decisions",
      "indicators": ["tier_A", "score_>80", "context_>128k"]
    },
    "balanced_reasoning": {
      "description": "Moderate reasoning, general tasks",
      "indicators": ["tier_B+", "score_>75", "context_>128k"]
    },
    "coding_specialized": {
      "description": "Code generation and analysis",
      "indicators": ["coding_score_>80", "swe_bench_>60", "supports_tools"]
    },
    "agentic_coding": {
      "description": "Codebase navigation, multi-file editing",
      "indicators": ["swe_bench_>70", "supports_file_ops", "context_>200k"]
    },
    "speed": {
      "description": "Fast response, low latency",
      "indicators": ["tokens_per_sec_>100", "time_to_first_token_<1s"]
    },
    "long_context": {
      "description": "Large context window",
      "indicators": ["context_window_>200k"]
    },
    "low_cost": {
      "description": "Low cost per token",
      "indicators": ["cost_per_1m_<0.10"]
    },
    "multimodal": {
      "description": "Image/video support",
      "indicators": ["supports_vision", "supports_audio"]
    }
  },

  "role_requirements": {
    "description": "Capability requirements per role. The router finds models that satisfy these requirements.",
    
    "senior_architect": {
      "required_capabilities": ["deep_reasoning", "long_context"],
      "preferred_capabilities": ["coding_specialized"],
      "min_tier": "A",
      "min_context_window": 128000,
      "rationale": "Architecture requires deep reasoning and systemic vision"
    },
    "fullstack_developer": {
      "required_capabilities": ["coding_specialized", "balanced_reasoning"],
      "preferred_capabilities": ["agentic_coding", "long_context"],
      "min_tier": "A-",
      "min_context_window": 128000,
      "rationale": "Full-stack development benefits from a versatile model that balances coding and reasoning"
    },
    "code_reviewer": {
      "required_capabilities": ["agentic_coding", "balanced_reasoning"],
      "preferred_capabilities": ["long_context"],
      "min_tier": "A-",
      "min_context_window": 128000,
      "rationale": "Multi-file code review requires codebase navigation"
    },
    "qa_tester": {
      "required_capabilities": ["coding_specialized"],
      "preferred_capabilities": ["balanced_reasoning"],
      "min_tier": "B+",
      "min_context_window": 64000,
      "rationale": "Unit test generation benefits from a coding specialist"
    },
    "db_architect": {
      "required_capabilities": ["deep_reasoning", "balanced_reasoning"],
      "preferred_capabilities": ["long_context"],
      "min_tier": "A",
      "min_context_window": 128000,
      "rationale": "Data modeling (schema-first) requires deep reasoning"
    },
    "devops_sre": {
      "required_capabilities": ["speed", "balanced_reasoning"],
      "preferred_capabilities": ["low_cost", "long_context"],
      "min_tier": "B",
      "min_context_window": 64000,
      "rationale": "DevOps/SRE prioritizes speed for pipelines and operations"
    },
    "security_analyst": {
      "required_capabilities": ["deep_reasoning", "balanced_reasoning"],
      "preferred_capabilities": ["long_context"],
      "min_tier": "A-",
      "min_context_window": 128000,
      "rationale": "Security requires deep reasoning for threat modeling"
    }
  },

  "matching_algorithm": {
    "description": "How to find the best model for a role",
    "steps": [
      "1. LIST: Get all available models from provider",
      "2. FILTER: Keep only models that satisfy min_tier and min_context_window",
      "3. SCORE: Calculate match score based on required_capabilities (weight 70%) + preferred_capabilities (weight 30%)",
      "4. SORT: Sort by descending score",
      "5. SELECT: Primary = #1, Fallback_1 = #2, Fallback_2 = #3",
      "6. VALIDATE: Ensure selected models are in openclaw.json"
    ],
    "scoring": {
      "required_match": 10,
      "preferred_match": 5,
      "tier_bonus": { "S": 20, "A": 15, "A-": 12, "B+": 8, "B": 5, "B-": 3, "C": 1, "D": 0 },
      "context_bonus": "+1 per 64k above minimum"
    }
  },

  "agent_role_mapping": {
    "description": "Agent to role mapping. No model IDs, only role references.",
    
    "architect_agent": {
      "roles": ["senior_architect"],
      "description": "Senior Architect — architectural decisions, ADRs, stack"
    },
    "developer_agent": {
      "roles": ["fullstack_developer"],
      "description": "Full-Stack Developer — feature implementation, code"
    },
    "reviewer_agent": {
      "roles": ["code_reviewer", "qa_tester"],
      "model_switching": true,
      "role_contexts": {
        "code_reviewer": "When reviewing PRs and existing code",
        "qa_tester": "When generating tests and validating coverage"
      },
      "description": "Code Reviewer + QA Tester — code quality and tests"
    },
    "db_agent": {
      "roles": ["db_architect"],
      "description": "DB Architect — data modeling, migrations, queries"
    },
    "devops_agent": {
      "roles": ["devops_sre", "security_analyst"],
      "model_switching": true,
      "role_contexts": {
        "devops_sre": "When configuring pipelines, infra, deploys",
        "security_analyst": "When analyzing vulnerabilities, threat modeling"
      },
      "description": "DevOps/SRE + Security Analyst — infrastructure and security"
    }
  },

  "dynamic_allocation": {
    "description": "How the algorithm allocates models at runtime",
    
    "on_init": {
      "step_1": "Detect agent's active role",
      "step_2": "Consult role_requirements for the role",
      "step_3": "Execute matching_algorithm",
      "step_4": "Return allocated model"
    },
    
    "on_role_switch": {
      "trigger": "When agent changes role (e.g., Agent: DevOps → Security)",
      "action": "Re-execute matching_algorithm for new role",
      "optimization": "Prefer keeping current model if it satisfies the new role"
    },
    
    "on_concurrency_limit": {
      "trigger": "3 models already in use",
      "strategy": "priority-based-eviction",
      "rules": [
        "1. Check if any agent is idle (>5min without activity)",
        "2. If yes, free the idle agent's model",
        "3. If no, use fallback for the requested model",
        "4. Fallbacks prefer already-loaded models (same provider family)"
      ]
    }
  },

  "provider_families": {
    "description": "Provider grouping for fallback optimization",
    "note": "Used only as optimization hint, not as restriction",
    
    "deepseek_family": {
      "providers": ["ollama/deepseek-*"],
      "characteristics": ["MoE", "chinese", "high context"]
    },
    "kimi_family": {
      "providers": ["ollama/kimi-*"],
      "characteristics": ["MoE", "chinese", "agentic"]
    },
    "qwen_family": {
      "providers": ["ollama/qwen*"],
      "characteristics": ["Alibaba", "coding", "multimodal"]
    },
    "devstral_family": {
      "providers": ["ollama/devstral-*"],
      "characteristics": ["Mistral", "agentic", "SWE-bench"]
    }
  },

  "override_policy": {
    "description": "Agents can override dynamic allocations",
    "methods": [
      "File: ~/.openclaw/workspace/agents/<name>/factory-init-overrides.json",
      "Section in workspace AGENTS.md",
      "Environment variable: FACTORY_INIT_OVERRIDE_PATH"
    ],
    "constraints": [
      "Overrides must use models available in openclaw.json",
      "Overrides cannot increase max_concurrent_models",
      "Overrides are the agent/PO's responsibility",
      "Overrides can specify exact provider or capabilities"
    ]
  },

  "example_workflow": {
    "description": "Example of how the router works in practice",
    
    "scenario": "Agent starts project in Security mode",
    "available_models": [
      "ollama/glm-5.1:cloud",
      "ollama/qwen3-coder:480b-cloud",
      "ollama/kimi-k2.6:cloud"
    ],
    
    "step_1": "Agent requires role 'security_analyst'",
    "step_2": "Consult role_requirements[security_analyst]",
    "step_3": "Requirements: deep_reasoning + balanced_reasoning, min_tier=A-",
    "step_4": "Filter available: glm-5.1 (B+ ❌), qwen3-coder (A- ✅), kimi-k2.6 (A ✅)",
    "step_5": "Score: kimi-k2.6 = deep_reasoning(10) + long_context(5) + tier_A(15) = 30",
    "step_6": "Score: qwen3-coder = balanced_reasoning(5) + coding(10) + tier_A-(12) = 27",
    "step_7": "Result: Primary=kimi-k2.6, Fallback_1=qwen3-coder, Fallback_2=glm-5.1"
  }
}
